# Chep thanh .env roi dien gia tri that. KHONG commit tep .env.
# Tren InfinityFree: tao .env ngay tren may chu bang File Manager, khong tai tu may len git.

CI_ENVIRONMENT = production

# Dia chi goc cua web, co dau / cuoi. Vi du may cuc bo: 'http://localhost:8080/'
app.baseURL =
app.indexPage = ''
# Ep HTTPS da lam o .htaccess; bat o day co the gay chuyen huong vong lap sau proxy cua nha cung cap
app.forceGlobalSecureRequests = false

# Tren InfinityFree la sqlNNN.infinityfree.com (xem muc MySQL Databases), khong phai localhost
database.default.hostname =
database.default.database =
database.default.username =
database.default.password =
database.default.DBDriver = MySQLi
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci
database.default.port = 3306

# Cookie phien: HttpOnly, Secure, SameSite (Muc 5.3)
cookie.secure = true
cookie.httponly = true
cookie.samesite = 'Lax'

session.cookieName = 'ci_session'
session.expiration = 7200

# Khoa bi mat cho tac vu noi bo nhac han (F6.3, header X-Khoa-Noi-Bo). De trong thi diem cuoi noi bo luon tu choi.
noibo.khoa =
